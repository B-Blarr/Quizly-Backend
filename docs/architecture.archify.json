    "views": [
      {
        "id": "auth",
        "label": "Signing in",
        "focus": [
          "frontend",
          "auth",
          "api"
        ],
        "note": "Login sets both tokens as HttpOnly cookies, so the frontend never touches a token. Logout blacklists the refresh token."
      },
      {
        "id": "chain",
        "label": "From link to quiz",
        "focus": [
          "frontend",
          "api",
          "youtube",
          "ytdlp",
          "whisper",
          "gemini",
          "check",
          "db"
        ],
        "note": "One POST runs the whole chain: audio download, local transcription, Gemini, a check, the database. The quiz comes back as 201."
      },
      {
        "id": "local",
        "label": "What stays local",
        "focus": [
          "ytdlp",
          "whisper",
          "gemini"
        ],
        "note": "The audio is transcribed on the machine and deleted right after. Only the transcript text goes to Gemini."
      }
    ],
